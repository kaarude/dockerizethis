--- Dockerfile (mode 0644) ---
FROM python:3.12-slim AS builder
WORKDIR /app
RUN python -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
RUN pip install --no-cache-dir pdm
COPY . .
RUN pdm export --prod --format requirements --output /tmp/requirements.txt \
    && /opt/venv/bin/pip install --no-cache-dir --no-deps -r /tmp/requirements.txt

FROM python:3.12-slim AS runtime
WORKDIR /app
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=10001:10001 . .
USER 10001:10001
CMD ["/bin/sh","-c","exec python -m worker"]
--- .dockerignore (mode 0644) ---
.venv
venv
__pycache__
*.pyc
.git
.env*
tests
.pytest_cache
.mypy_cache
Dockerfile
docker-compose.yml
