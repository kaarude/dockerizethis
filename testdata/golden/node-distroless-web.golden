--- Dockerfile (mode 0644) ---
FROM node:22-alpine AS deps
WORKDIR /app
ENV NODE_ENV=production
ENV PATH="/app/node_modules/.bin:$PATH"
COPY package.json package-lock.json ./
RUN NODE_ENV=development npm ci

FROM deps AS build
COPY . .
RUN npm run build

FROM gcr.io/distroless/nodejs22 AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=1001:1001 /app /app
USER 1001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/nodejs/bin/node","-e","fetch(\"http://127.0.0.1:3000/health\").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["dist/server.js"]
--- .dockerignore (mode 0644) ---
node_modules
.git
dist
.env*
*.md
Dockerfile
docker-compose.yml
