--- Dockerfile (mode 0644) ---
FROM gradle:jdk21 AS builder
WORKDIR /app
COPY . .
RUN ./gradlew --no-daemon build -x test
# A glob copy fails when the build produced more than one jar; in that case
# pin the artifact name in the build configuration.
RUN cp build/libs/*.jar /app/app.jar

FROM eclipse-temurin:21-jre AS runtime
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
WORKDIR /app
COPY --from=builder --chown=10001:10001 /app/app.jar /app/app.jar
USER 10001:10001
EXPOSE 8080
CMD ["/bin/sh","-c","exec java -cp /app/app.jar com.example.MainKt"]
--- .dockerignore (mode 0644) ---
.git
.env*
target
build
.gradle
out
*.class
Dockerfile
docker-compose.yml
