FROM {{.BuildImage}} AS builder
WORKDIR /app
COPY . .
RUN {{.BuildCmd}}
{{if not .QuarkusDir}}# A glob copy fails when the build produced more than one jar; in that case
# pin the artifact name in the build configuration.
RUN cp {{.JarGlob}} /app/app.jar
{{end}}
FROM eclipse-temurin:{{.Version}}-jre AS runtime
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
WORKDIR /app
{{if .QuarkusDir}}COPY --from=builder --chown=10001:10001 /app/{{.QuarkusDir}}/ /app/quarkus-app/
{{else}}COPY --from=builder --chown=10001:10001 /app/app.jar /app/app.jar
{{end}}USER 10001:10001
{{if eq .Process "web"}}EXPOSE {{.Port}}
{{end}}CMD {{.Command}}
