# generated by dockerizethis — edit freely
# detected plan: {{.Stack}} {{.Version}} ({{.Process}})
name: docker

on:
  push:
    branches: [main]
    tags: ["v*.*.*"]

permissions:
  contents: read
  packages: write

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: {{gh "github.repository"}}

jobs:
  docker:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      # ghcr.io rejects uppercase repository names.
      - name: Lowercase image name
        run: echo "IMAGE_NAME=${IMAGE_NAME,,}" >> "$GITHUB_ENV"
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      - name: Log in to ghcr.io
        uses: docker/login-action@v3
        with:
          registry: {{gh "env.REGISTRY"}}
          username: {{gh "github.actor"}}
          password: {{gh "secrets.GITHUB_TOKEN"}}
      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            {{gh "env.REGISTRY"}}/{{gh "env.IMAGE_NAME"}}:{{gh `github.ref_name == 'main' && 'latest' || github.ref_name`}}
            {{gh "env.REGISTRY"}}/{{gh "env.IMAGE_NAME"}}:sha-{{gh "github.sha"}}
