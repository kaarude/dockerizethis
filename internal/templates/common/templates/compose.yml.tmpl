# generated by dockerize — edit freely
{{- if .UnknownProcess }}
# TODO: process type "{{.Process}}" is unknown to dockerize; review the app service before deploying.
{{- end }}
services:
  app:
    build: .
    restart: unless-stopped
{{- if .Env }}
    env_file:
      - .env
{{- end }}
{{- if or .Web .Static }}
    ports:
      - "{{.Port}}:{{.Port}}"
{{- end }}
{{- if .DependsOn }}
    depends_on:
{{- range .DependsOn }}
      {{.}}:
        condition: service_healthy
{{- end }}
{{- end }}
    networks:
      - default
{{- range .Services }}
{{- if eq . "postgres" }}
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-app}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      POSTGRES_DB: ${POSTGRES_DB:-app}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER:-app} -d $${POSTGRES_DB:-app}"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - default
{{- else if eq . "redis" }}
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - default
{{- else if eq . "mysql" }}
  mysql:
    image: mysql:8
    restart: unless-stopped
    environment:
      MYSQL_USER: ${MYSQL_USER:-app}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:?set MYSQL_PASSWORD in .env}
      MYSQL_DATABASE: ${MYSQL_DATABASE:-app}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:?set MYSQL_ROOT_PASSWORD in .env}
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - default
{{- else if eq . "mongo" }}
  mongo:
    image: mongo:7
    restart: unless-stopped
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_INITDB_ROOT_USERNAME:-app}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_INITDB_ROOT_PASSWORD:?set MONGO_INITDB_ROOT_PASSWORD in .env}
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - mongo_data:/data/db
    networks:
      - default
{{- else }}
  # TODO: dockerize has no compose block for service "{{.}}"; configure it here.
{{- end }}
{{- end }}
{{- if .Volumes }}

volumes:
{{- range .Volumes }}
  {{.}}:
{{- end }}
{{- end }}

networks:
  default:
    driver: bridge
