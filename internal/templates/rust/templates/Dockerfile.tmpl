FROM rust:{{.Version}}-bookworm AS builder
WORKDIR /app
{{if .BuildPkgs}}RUN apt-get update && apt-get install -y --no-install-recommends {{.BuildPkgs}} \
    && rm -rf /var/lib/apt/lists/*
{{end}}COPY . .
RUN cargo build --release --bin {{.Bin}}{{if .BinPackage}} --package {{.BinPackage}}{{end}}

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates{{if .RuntimePkgs}} {{.RuntimePkgs}}{{end}} \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
WORKDIR /app
COPY --from=builder --chown=10001:10001 /app/target/release/{{.Bin}} /app/server
USER 10001:10001
{{if eq .Process "web"}}EXPOSE {{.Port}}
{{end}}CMD ["/app/server"]
